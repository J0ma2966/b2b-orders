<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS и системные сертификаты; пользовательские CA в рабочей сборке не принимаются -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
