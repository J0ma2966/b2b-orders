DATABASE_URL="postgresql://b2b:b2b@localhost:5432/b2b?schema=public"
# Каталог для логотипов и фото (в продакшене — постоянный диск или S3)
UPLOAD_DIR="./storage/uploads"
# Первый супер-администратор, создаётся командой npm run db:seed
SUPERADMIN_PHONE="+998900000000"
SUPERADMIN_PASSWORD=""
# Push-уведомления (ТЗ п. 57). Ключи: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.uz"
# Фоновые задачи (напоминания, автоотмена, счета на комиссию) идут внутри сервера каждые 5 минут.
# JOBS_DISABLED=1 выключает их в этом экземпляре; CRON_SECRET разрешает внешний запуск POST /api/cron
JOBS_DISABLED=""
CRON_SECRET=""
# Push в мобильном приложении (docs/mobile.md). Android — Firebase Cloud Messaging:
# JSON сервисного аккаунта Firebase одной строкой или путь к файлу
FCM_SERVICE_ACCOUNT=""
FCM_SERVICE_ACCOUNT_FILE=""
# iOS — Apple Push Notification service: ключ .p8 (содержимое или путь), его Key ID, Team ID, bundle id приложения
APNS_KEY=""
APNS_KEY_FILE=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="uz.b2borders.app"
# 1 — боевой сервер Apple (сборки из App Store и TestFlight), пусто — sandbox (сборки из Xcode)
APNS_PRODUCTION=""
# Владелец платформы и контакты для политики конфиденциальности (/privacy) и страницы удаления аккаунта
LEGAL_OPERATOR_NAME=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CONTACT_PHONE=""
# Флаг Secure у cookie входа: по умолчанию снимается сам только для локальных адресов (http://192.168…:3000,
# docs/local-wifi.md). 0 — выключить всегда (локальная сеть с другими адресами), 1 — включить всегда. На боевом сервере не задавать
COOKIE_SECURE=""
