// Схема данных B2B-платформы заказов (ТЗ v2.1).
// Этап 1: пользователи, роли, сессии, поставщики, магазины, территории, аудит, уведомления.
// Этап 2: категории, товары, единицы измерения, цены, остатки, журнал складских операций.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Пользователи и сессии ─────────────

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED // удалил аккаунт сам: личные данные обезличены, история заказов организации сохранена
}

model User {
  id           String     @id @default(cuid())
  phone        String     @unique // нормализованный, +998XXXXXXXXX
  passwordHash String
  fullName     String
  email        String?
  isSuperAdmin Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  // Пароль выдан администратором, пользователь должен сменить его при входе
  mustChangePassword Boolean @default(false)
  // Push-уведомления; внутренние уведомления сохраняются независимо (ТЗ п. 57)
  pushEnabled  Boolean    @default(true)
  // Язык интерфейса (ru, uz): для push и уведомлений, когда пользователь не в приложении
  locale       String     @default("ru")
  // Чат с ботом входа в Telegram (ID чата), куда приходят коды; привязывается, когда человек
  // делится в боте своим номером — Telegram присылает номер владельца аккаунта
  telegramChatId String?  @unique
  // Когда владелец номера сам подтвердил его кодом (регистрация, вход по коду). Учётную запись,
  // которую завёл кто-то другой (добавление сотрудника), до этого момента нельзя считать его:
  // при первом входе по коду чужие сессии закрываются и пароль сбрасывается.
  phoneVerifiedAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions          Session[]        @relation("SessionUser")
  actingSessions    Session[]        @relation("SessionActingAs")
  supplierMembers   SupplierMember[]
  shopMembers       ShopMember[]
  notifications     Notification[]
  courierOrders     Order[]          @relation("OrderCourier")
  courierReplacements Replacement[]  @relation("ReplacementCourier")
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]
  courierTerritories SupplierTerritory[] @relation("TerritoryCourier")
  cashHandovers      CashHandover[]      @relation("HandoverCourier")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 от токена из cookie
  userId    String
  user      User     @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  // «Действие от имени» (ТЗ п. 63): супер-админ работает как пользователь поставщика
  actingAsUserId String?
  actingAsUser   User?   @relation("SessionActingAs", fields: [actingAsUserId], references: [id], onDelete: SetNull)
  // Активный контекст, если пользователь состоит в нескольких организациях
  activeSupplierId String?
  activeShopId     String?
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // Вход по одноразовому коду: до этого времени можно задать новый пароль без старого
  passwordResetUntil DateTime?
  deviceTokens DeviceToken[]

  @@index([userId])
}

enum CodeChannel {
  TELEGRAM
  SMS
}

// Одноразовый код входа (Telegram или SMS) и привязка Telegram из профиля (purpose = LINK).
// Сам код хранится только хешем. Для бота код создаётся в момент отправки: если чат ещё не
// привязан, человек открывает бота по ссылке с linkToken и делится номером — тогда код и приходит.
model LoginCode {
  id         String      @id @default(cuid())
  phone      String
  userId     String?
  purpose    String      @default("LOGIN") // LOGIN | LINK
  channel    CodeChannel
  codeHash   String?
  linkToken  String?     @unique
  chatId     String?
  attempts   Int         @default(0)
  ip         String?
  sentAt     DateTime?
  usedAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime    @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([chatId, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  phone     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

// ───────────── Территории ─────────────

enum TerritoryType {
  COUNTRY
  REGION
  CITY
  DISTRICT
}

model Territory {
  id       String        @id @default(cuid())
  name     String
  type     TerritoryType
  parentId String?
  parent   Territory?    @relation("TerritoryTree", fields: [parentId], references: [id])
  children Territory[]   @relation("TerritoryTree")
  isActive Boolean       @default(true)
  sortOrder Int          @default(0)

  supplierTerritories SupplierTerritory[]
  shops               Shop[]
  suppliersOffice     Supplier[]

  @@unique([parentId, name])
  @@index([parentId])
}

// ───────────── Поставщики ─────────────

enum SupplierStatus {
  PENDING      // На проверке
  NEEDS_INFO   // Запрошены дополнительные сведения
  ACTIVE       // Подтверждён
  REJECTED     // Отклонён
  BLOCKED      // Заблокирован
}

model Supplier {
  id             String         @id @default(cuid())
  legalName      String         // название юридического лица
  displayName    String         // название для магазинов
  inn            String         @unique
  legalAddress   String
  phone          String
  extraPhones    String[]
  email          String
  website        String?
  contactPerson  String
  description    String?
  logoPath       String?
  // Счётчик автоматических артикулов товаров (A-00001, A-00002…), см. lib/sku.ts
  skuSeq         Int            @default(0)
  // Главный офис
  officeTerritoryId String?     // город/район офиса
  officeTerritory   Territory?  @relation(fields: [officeTerritoryId], references: [id])
  officeAddress  String
  officeLat      Float?
  officeLng      Float?

  status            SupplierStatus @default(PENDING)
  moderationComment String?        // причина отказа или что нужно дополнить
  // Индивидуальная комиссия, %; null — действует стандартная ставка платформы
  commissionRate    Decimal?       @db.Decimal(5, 2)
  // Антифрод-меры (ТЗ п. 56)
  hiddenFromShops   Boolean        @default(false)
  ordersDisabled    Boolean        @default(false)

  // Условия заказа (П5): минимальная сумма и приём заказов до часа H (доставка — со следующего дня)
  minOrderTotal     Decimal?       @db.Decimal(14, 2)
  orderCutoffHour   Int?
  // Л1: заказ сверх доступного кредита — запрещать (true) или только предупреждать
  creditOverLimitBlock Boolean     @default(false)
  // П2: без отдельной сборки — «Принят» сразу переходит в «Готов к доставке»
  skipAssembly      Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvedAt DateTime?

  members     SupplierMember[]
  territories SupplierTerritory[]
  statusHistory SupplierStatusHistory[]
  categories  Category[]
  products    Product[]
  antifraudEvents AntifraudEvent[]
  orders      Order[]
  bonusPromotions BonusPromotion[]
  shopAccounts ShopAccount[]
  replacements Replacement[]
  returnedItems ReturnedItem[]
  cashHandovers CashHandover[]
  commissionInvoices CommissionInvoice[]
}

enum SupplierRole {
  OWNER   // представитель юрлица, подавший заявку
  ADMIN   // администратор поставщика
  COURIER // доставщик
}

model SupplierMember {
  id         String       @id @default(cuid())
  supplierId String
  supplier   Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       SupplierRole
  isActive   Boolean      @default(true)
  // Владелец или администратор сам развозит заказы (ИП без доставщиков): ему можно
  // назначать доставки, и ему открыто приложение доставщика. Доставщику не нужен.
  delivers   Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@unique([supplierId, userId])
  @@index([userId])
}

model SupplierTerritory {
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  // П5: дни доставки, 1 — понедельник … 7 — воскресенье; пусто — каждый день
  deliveryWeekdays Int[] @default([])
  // П8: доставщик, закреплённый за территорией
  courierId   String?
  courier     User?     @relation("TerritoryCourier", fields: [courierId], references: [id], onDelete: SetNull)

  @@id([supplierId, territoryId])
  @@index([territoryId])
}

model SupplierStatusHistory {
  id         String          @id @default(cuid())
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fromStatus SupplierStatus?
  toStatus   SupplierStatus
  comment    String?
  userId     String?
  createdAt  DateTime        @default(now())

  @@index([supplierId])
}

// ───────────── Магазины ─────────────

enum ShopStatus {
  NEW          // Новый
  VERIFIED     // Проверенный (после первой успешной доставки)
  FAILED_CHECK // Не прошёл проверку
}

model Shop {
  id           String     @id @default(cuid())
  name         String
  inn          String?
  phone        String
  phone2       String?
  photoPaths   String[]
  address      String
  lat          Float
  lng          Float
  contactName  String
  // Самая точная территория магазина (район или город); регион определяется по дереву
  territoryId  String
  territory    Territory  @relation(fields: [territoryId], references: [id])
  status       ShopStatus @default(NEW)
  isBlocked    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  members       ShopMember[]
  statusHistory ShopStatusHistory[]
  orders        Order[]
  accounts      ShopAccount[]
  replacements  Replacement[]
  returnedItems ReturnedItem[]
  favorites     FavoriteProduct[]

  @@index([territoryId])
}

enum ShopRole {
  OWNER
  STAFF
}

model ShopMember {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ShopRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
  @@index([userId])
}

model ShopStatusHistory {
  id         String      @id @default(cuid())
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fromStatus ShopStatus?
  toStatus   ShopStatus
  reason     String?
  userId     String?
  createdAt  DateTime    @default(now())

  @@index([shopId])
}

// ───────────── Настройки платформы ─────────────

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────── Аудит (ТЗ п. 63–64) ─────────────

model AuditLog {
  id         String   @id @default(cuid())
  // Фактический пользователь (кто нажал кнопку)
  actorUserId String?
  // От чьего имени выполнено действие (если супер-админ действует от имени)
  onBehalfOfUserId String?
  actorRole  String   // SUPER_ADMIN, SUPPLIER_OWNER, SUPPLIER_ADMIN, COURIER, SHOP, SYSTEM
  entity     String   // Supplier, Shop, User, Territory, ...
  entityId   String?
  action     String   // create, update, approve, block, ...
  // [{ field, old, new }]
  changes    Json?
  comment    String?
  supplierId String?
  shopId     String?
  source     String   @default("web")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([supplierId, createdAt])
  @@index([shopId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

// ───────────── Уведомления (ТЗ п. 57, 85) ─────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  entity    String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ───────────── Каталог (ТЗ п. 14–17) ─────────────

model Category {
  id         String     @id @default(cuid())
  supplierId String
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int        @default(0)
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  products   Product[]

  @@unique([supplierId, name])
}

model Product {
  id          String    @id @default(cuid())
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  brand       String?
  sku         String?   // артикул поставщика; пустой при создании — присваивается автоматически
  weightKg    Decimal?  @db.Decimal(10, 3)
  // Характеристики: [{ name, value }]
  attributes  Json      @default("[]")
  photoPaths  String[]
  // Доступность для заказа (поставщик может временно снять товар с продажи)
  isAvailable Boolean   @default(true)
  // Товар можно заменить по заявке магазина (ТЗ п. 14, 45)
  allowReplacement Boolean @default(true)
  // Удаление из актуального каталога без потери истории (ТЗ п. 17)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  units ProductUnit[]
  favorites FavoriteProduct[]

  @@index([supplierId, archivedAt])
  @@index([categoryId])
}

enum UnitKind {
  PIECE  // штука
  BOX    // коробка
  BLOCK  // блок
  KG     // килограмм
  PACK   // упаковка
  LITER  // литр
  OTHER  // другая (название в customName)
}

// Единица продажи товара со своей ценой и своим остатком.
// Связи между единицами (1 коробка = 24 шт.) в обязательную функциональность не входят (ТЗ п. 15),
// поэтому остаток ведётся по каждой единице отдельно.
model ProductUnit {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind        UnitKind
  customName  String   @default("")
  // Нет цены — заказ в этой единице невозможен (ТЗ п. 15)
  price       Decimal? @db.Decimal(14, 2)
  physicalQty Decimal  @default(0) @db.Decimal(14, 3)
  reservedQty Decimal  @default(0) @db.Decimal(14, 3)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // П6: порог «мало на складе» по доступному остатку; уведомление — при переходе ниже порога
  lowStockThreshold Decimal? @db.Decimal(14, 3)
  // Л4: «коробка = 24 шт.» — остаток ведётся в базовой единице (baseUnit), а у этой единицы
  // physicalQty хранит готовое число целых коробок из доступного остатка (reservedQty = 0)
  baseUnitId  String?
  baseUnit    ProductUnit? @relation("UnitBase", fields: [baseUnitId], references: [id], onDelete: SetNull)
  linkedUnits ProductUnit[] @relation("UnitBase")
  baseQty     Decimal? @db.Decimal(14, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements    StockMovement[]
  priceHistory PriceHistory[]
  antifraudEvents AntifraudEvent[]
  orderItems   OrderItem[]
  replacements Replacement[]
  returnedItems ReturnedItem[]
  bonusTriggers BonusPromotion[] @relation("BonusTrigger")
  bonusGifts    BonusPromotion[] @relation("BonusGift")

  @@unique([productId, kind, customName])
  @@index([baseUnitId])
}

model PriceHistory {
  id            String      @id @default(cuid())
  productUnitId String
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  oldPrice      Decimal?    @db.Decimal(14, 2)
  newPrice      Decimal?    @db.Decimal(14, 2)
  userId        String?
  createdAt     DateTime    @default(now())

  @@index([productUnitId, createdAt])
}

// ───────────── Журнал складских операций (ТЗ п. 20) ─────────────

enum StockMovementType {
  INITIAL           // начальный остаток
  INCOME            // приход
  RESERVE           // резервирование
  RELEASE           // освобождение резерва
  SALE              // продажа (из резерва в реализованное)
  BONUS             // бонус
  FORCED_SALE       // принудительная продажа
  RETURN_UNACCEPTED // возврат непринятого товара
  TO_RETURNED       // перевод в возвращённые товары
  REPLACEMENT_OUT   // выдача товара по замене
  BACK_TO_STOCK     // возврат в оборот
  WRITE_OFF         // списание
  ADJUSTMENT        // ручная корректировка
}

model StockMovement {
  id            String            @id @default(cuid())
  productUnitId String
  productUnit   ProductUnit       @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  type          StockMovementType
  // Изменение физического и зарезервированного остатка (со знаком)
  physicalDelta Decimal           @db.Decimal(14, 3)
  reservedDelta Decimal           @db.Decimal(14, 3)
  physicalAfter Decimal           @db.Decimal(14, 3)
  reservedAfter Decimal           @db.Decimal(14, 3)
  userId        String?
  onBehalfOfUserId String?
  reason        String?
  relatedEntity String?
  relatedId     String?
  createdAt     DateTime          @default(now())

  @@index([productUnitId, createdAt])
  @@index([relatedEntity, relatedId])
}

// ───────────── Антифрод цен (ТЗ п. 54–56) ─────────────

enum AntifraudStatus {
  OPEN
  CONFIRMED   // изменение подтверждено
  REJECTED    // отклонено, цена восстановлена
  WATCHING    // под наблюдением
}

model AntifraudEvent {
  id            String          @id @default(cuid())
  supplierId    String
  supplier      Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productUnitId String
  productUnit   ProductUnit     @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  oldPrice      Decimal         @db.Decimal(14, 2)
  newPrice      Decimal         @db.Decimal(14, 2)
  changePct     Decimal         @db.Decimal(6, 2)
  userId        String?
  onBehalfOfUserId String?
  status        AntifraudStatus @default(OPEN)
  resolution    String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@index([status, createdAt])
  @@index([supplierId])
}

// ───────────── Заказы (ТЗ п. 21–29) ─────────────

enum OrderStatus {
  DRAFT                 // черновик = корзина магазина у одного поставщика
  PLACED                // оформлен
  ACCEPTED              // принят поставщиком
  ASSEMBLING            // собирается
  READY                 // готов к доставке
  ASSIGNED              // назначен доставщику
  IN_TRANSIT            // в пути
  DELIVERED             // доставлен
  COMPLETED             // завершён
  CANCELLED_BY_SHOP     // отменён магазином
  CANCELLED_BY_SUPPLIER // отменён поставщиком
  REJECTED              // отклонён поставщиком
  NOT_DELIVERED         // не доставлен
  PARTIALLY_ACCEPTED    // частично принят
  NEEDS_CONFIRMATION    // требует подтверждения
  DELIVERY_PROBLEM      // проблема при доставке
}

enum PaymentMethod {
  CASH     // наличные
  CARD     // карта
  TRANSFER // безналичный расчёт
}

enum OrderItemKind {
  REGULAR // обычная продажа
  FORCED  // принудительная продажа
  BONUS   // бонус
}

enum CancelSide {
  SHOP
  SUPPLIER
  PLATFORM
}

model Order {
  id         String      @id @default(cuid())
  // Номер присваивается при оформлении (последовательность order_number_seq)
  number     Int?        @unique
  supplierId String
  supplier   Supplier    @relation(fields: [supplierId], references: [id])
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id])
  status     OrderStatus @default(DRAFT)
  createdByUserId String?

  paymentMethod PaymentMethod?
  comment       String?
  // Данные доставки фиксируются на момент оформления
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  contactName     String?
  contactPhone    String?
  deliveryDate    DateTime? @db.Date // желаемая дата доставки

  // Сумма заказанных позиций (обычные + принудительные); после приёмки — по фактически принятому
  total          Decimal  @default(0) @db.Decimal(14, 2)
  // Ставка комиссии, действовавшая при оформлении (ТЗ п. 53)
  commissionRate Decimal? @db.Decimal(5, 2)

  courierId  String?
  courier    User?     @relation("OrderCourier", fields: [courierId], references: [id])

  placedAt    DateTime?
  acceptedAt  DateTime?
  assignedAt  DateTime?
  cancelledAt DateTime?
  cancelledBy CancelSide?
  cancelReason String?

  // QR-подтверждение получения (ТЗ п. 34–35): одноразовый код конкретного заказа
  qrToken     String?   @unique
  qrUsedAt    DateTime?
  inTransitAt DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  // Сумма до приёмки (заказанное); total после приёмки — по фактически принятому
  orderedTotal Decimal? @db.Decimal(14, 2)
  // Корректирующие операции после завершения (ТЗ п. 65–66)
  correctionTotal Decimal @default(0) @db.Decimal(14, 2)

  // Оплата при получении (ТЗ п. 38–42)
  receivedAmount Decimal?       @db.Decimal(14, 2)
  receivedMethod PaymentMethod?
  paidToOrder    Decimal?       @db.Decimal(14, 2)
  paidToDebt     Decimal?       @db.Decimal(14, 2)
  overpaid       Decimal?       @db.Decimal(14, 2)
  orderDebt      Decimal?       @db.Decimal(14, 2)
  balanceBefore  Decimal?       @db.Decimal(14, 2)
  balanceAfter   Decimal?       @db.Decimal(14, 2)

  // Запрос магазина на отмену во время доставки (ТЗ п. 28)
  cancelRequestedAt     DateTime?
  cancelRequestReason   String?
  statusBeforeRequest   OrderStatus?
  // Проблема при доставке / причина недоставки
  problemNote String?
  // Д3: причина из списка (PROBLEM_REASONS) и фото с места
  problemReason String?
  problemPhotoPaths String[]
  problemAt   DateTime?
  // Л2: напоминание поставщику о заказе без ответа или о нерешённой проблеме уже отправлено
  staleRemindedAt DateTime?
  // Л7: напоминание о забытой корзине
  cartRemindedAt DateTime?
  // Д2: порядок в маршруте дня доставщика
  routeOrder  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  OrderItem[]
  events OrderEvent[]
  debtEntries  DebtEntry[]
  replacements Replacement[] @relation("ReplacementOrder")
  replacementsNew Replacement[] @relation("ReplacementNewOrder")
  returnedItems ReturnedItem[]

  @@index([shopId, status])
  @@index([supplierId, status, placedAt])
  @@index([courierId, status])
}

model OrderItem {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productUnitId String
  productUnit   ProductUnit   @relation(fields: [productUnitId], references: [id])
  kind          OrderItemKind @default(REGULAR)
  // Снимок на момент оформления: каталог может меняться, заказ — нет
  productName   String
  unitLabel     String
  price         Decimal       @db.Decimal(14, 2) // для бонуса 0
  qty           Decimal       @db.Decimal(14, 3)
  deliveredQty  Decimal?      @db.Decimal(14, 3)
  acceptedQty   Decimal?      @db.Decimal(14, 3)
  bonusPromotionId String?
  bonusPromotion   BonusPromotion? @relation(fields: [bonusPromotionId], references: [id])
  replacements  Replacement[]
  addedByUserId String?
  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@index([productUnitId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String       // status, item.forced_added, item.forced_removed, courier.assigned, …
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  userId     String?
  onBehalfOfUserId String?
  actorRole  String?
  comment    String?
  data       Json?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ───────────── Бонусы (ТЗ п. 50–51) ─────────────

model BonusPromotion {
  id          String      @id @default(cuid())
  supplierId  String
  supplier    Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String
  // Условие: купить triggerQty единиц triggerUnit
  triggerUnitId String
  triggerUnit   ProductUnit @relation("BonusTrigger", fields: [triggerUnitId], references: [id])
  triggerQty    Decimal     @db.Decimal(14, 3)
  // Подарок: giftQty единиц giftUnit
  giftUnitId    String
  giftUnit      ProductUnit @relation("BonusGift", fields: [giftUnitId], references: [id])
  giftQty       Decimal     @db.Decimal(14, 3)
  // За каждые triggerQty (20 шт. → 2 подарка) или один раз на заказ
  repeatable  Boolean     @default(true)
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items OrderItem[]

  @@index([supplierId, isActive])
}

// ───────────── Финансы: счёт магазина у поставщика (ТЗ п. 38–44) ─────────────

model ShopAccount {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  // Работа в долг разрешается поставщиком (ТЗ п. 39); лимит необязателен (п. 90.15)
  creditAllowed Boolean  @default(false)
  creditLimit   Decimal? @db.Decimal(14, 2)
  // Л3: отсрочка оплаты в днях; null — без срока
  paymentTermDays Int?
  // Срок, о котором уже напомнили магазину, и срок, просрочку которого уже отметили
  dueRemindedFor  DateTime?
  overdueNotifiedFor DateTime?
  // > 0 — долг магазина, < 0 — переплата (п. 42)
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries DebtEntry[]

  @@unique([shopId, supplierId])
  @@index([supplierId])
}

enum DebtEntryType {
  ORDER_CHARGE  // обязательство по заказу (принятые товары)
  ORDER_PAYMENT // оплата при получении
  DEBT_PAYMENT  // погашение задолженности
  CORRECTION    // корректирующая операция
}

model DebtEntry {
  id            String        @id @default(cuid())
  accountId     String
  account       ShopAccount   @relation(fields: [accountId], references: [id])
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  type          DebtEntryType
  // Со знаком: + увеличивает долг, − уменьшает
  amount        Decimal       @db.Decimal(14, 2)
  balanceAfter  Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod?
  comment       String?
  occurredAt    DateTime      @default(now())
  userId        String?
  onBehalfOfUserId String?
  correctsId    String?
  createdAt     DateTime      @default(now())

  @@index([accountId, createdAt])
  @@index([orderId])
}

// ───────────── Замены и возвращённые товары (ТЗ п. 45–49) ─────────────

enum ReplacementStatus {
  NEW       // на рассмотрении
  APPROVED  // согласована
  REJECTED  // отклонена
  ASSIGNED  // передана доставщику
  DONE      // выполнена
  CANCELLED // отменена магазином
  CREDITED  // Л5: стоимость зачтена в баланс магазина вместо замены
}

model Replacement {
  id            String            @id @default(cuid())
  number        Int               @unique @default(autoincrement())
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id])
  supplierId    String
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  orderId       String
  order         Order             @relation("ReplacementOrder", fields: [orderId], references: [id])
  orderItemId   String
  orderItem     OrderItem         @relation(fields: [orderItemId], references: [id])
  productUnitId String
  productUnit   ProductUnit       @relation(fields: [productUnitId], references: [id])
  productName   String
  unitLabel     String
  qty           Decimal           @db.Decimal(14, 3)
  reason        String
  comment       String?
  photoPaths    String[]
  videoPaths    String[]
  status        ReplacementStatus @default(NEW)
  decisionComment String?
  // Л5: сумма, зачтённая в баланс магазина
  creditedAmount Decimal?         @db.Decimal(14, 2)
  courierId     String?
  courier       User?             @relation("ReplacementCourier", fields: [courierId], references: [id])
  // Вариант «привязать к новому заказу» (ТЗ п. 46)
  newOrderId    String?
  newOrder      Order?            @relation("ReplacementNewOrder", fields: [newOrderId], references: [id])
  createdByUserId String?
  decidedAt     DateTime?
  assignedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  returnedItems ReturnedItem[]

  @@index([supplierId, status])
  @@index([shopId])
  @@index([courierId, status])
}

enum ReturnedStatus {
  PENDING_CHECK // ожидает проверки
  CHECKED       // проверен
  USABLE        // пригоден
  DEFECTIVE     // брак
  WRITTEN_OFF   // списан
  DISPOSED      // утилизирован
  BACK_TO_STOCK // возвращён в оборот
}

model ReturnedItem {
  id            String         @id @default(cuid())
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id])
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  replacementId String?
  replacement   Replacement?   @relation(fields: [replacementId], references: [id])
  productUnitId String
  productUnit   ProductUnit    @relation(fields: [productUnitId], references: [id])
  productName   String
  unitLabel     String
  qty           Decimal        @db.Decimal(14, 3)
  reason        String
  courierId     String?
  status        ReturnedStatus @default(PENDING_CHECK)
  comment       String?
  photoPaths    String[]
  videoPaths    String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([supplierId, status])
}

// ───────────── Push-уведомления (ТЗ п. 57) ─────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum DevicePlatform {
  ANDROID
  IOS
}

// Push в мобильном приложении: токен FCM (Android) или APNs (iOS) устройства.
// Привязан к сессии входа — после выхода на телефоне уведомления на него не приходят.
model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  platform  DevicePlatform
  token     String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@index([sessionId])
}

// ───────────── Касса доставщика (Д1) ─────────────

// Поставщик принял наличные у доставщика. На руках = наличные, полученные по заказам, минус сданное.
model CashHandover {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  courierId  String
  courier    User     @relation("HandoverCourier", fields: [courierId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  // Сколько было на руках в момент приёма: расхождение = onHand − amount
  onHand     Decimal  @db.Decimal(14, 2)
  comment    String?
  acceptedByUserId String?
  createdAt  DateTime @default(now())

  @@index([supplierId, courierId, createdAt])
}

// ───────────── Избранное магазина (М4) ─────────────

model FavoriteProduct {
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([shopId, productId])
}

// ───────────── Счета на комиссию платформы (А1) ─────────────

enum CommissionInvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

model CommissionInvoice {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  // Первый день месяца (Ташкент), за который выставлен счёт
  period     DateTime @db.Date
  orders     Int
  turnover   Decimal  @db.Decimal(14, 2)
  amount     Decimal  @db.Decimal(14, 2)
  dueDate    DateTime @db.Date
  status     CommissionInvoiceStatus @default(ISSUED)
  paidAt     DateTime?
  comment    String?
  remindedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, period])
  @@index([status, dueDate])
}

// ───────────── Почта техподдержки ─────────────
// Письма из ящика поддержки (IMAP), см. src/lib/support-mail.ts. В ящике письма не меняются.

model SupportEmail {
  id          String    @id @default(cuid())
  // Message-ID письма, а без него — «uidvalidity:uid»: повторная проверка не создаёт дубль
  messageKey  String    @unique
  uid         Int
  fromAddress String?
  fromName    String?
  replyTo     String?
  subject     String
  // Тема обращения из метки «[OptoLink: …]» в теме письма (src/lib/support-topics.ts)
  topic       String?
  // Gmail положил письмо в «Спам» (пересылает скрипт Gmail). Не попадает в «Новые» и счётчик раздела
  spam        Boolean   @default(false)
  text        String
  attachments Json?
  receivedAt  DateTime
  handledAt   DateTime?
  handledById String?
  createdAt   DateTime  @default(now())

  @@index([handledAt, receivedAt])
  @@index([receivedAt])
  @@index([topic, receivedAt])
}
